{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "branchPrefix": "chore/renovate-",
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^action\\.yml$/"
      ],
      "matchStrings": [
        "@aetherpush/cli@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "EXPECTED=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "@aetherpush/cli",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests\\/fixtures\\/CLI_VERSION$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@aetherpush/cli",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Open a CLI bump on the first Renovate run after the CLI is published. No cooldown: this is our own release, not a third-party dependency. Merged by hand because a CLI release can change what the action's flags do",
      "matchDepNames": [
        "@aetherpush/cli"
      ],
      "semanticCommitType": "fix",
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "prPriority": 10
    },
    {
      "matchDepNames": [
        "actions/setup-node"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "weekly updates"
    }
  ],
  "timezone": "America/Mexico_City",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "configMigration": true
}
