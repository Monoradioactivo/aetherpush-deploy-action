#!/usr/bin/env bash

set -euo pipefail

if [ "${1:-}" = "--version" ]; then
  tr -d ' \r\n' < "$AETHER_STUB_VERSION_FILE"
  exit 0
fi

if [ "${1:-}" != "release" ] && [ "${1:-}" != "release-react" ]; then
  printf 'unexpected command: %s\n' "${1:-}" >&2
  exit 64
fi

{
  printf 'cwd=%s\n' "$PWD"
  for arg in "$@"; do
    printf 'arg=%s\n' "$arg"
  done
} > "$AETHER_STUB_TRACE"

cat "$AETHER_STUB_FIXTURE"
